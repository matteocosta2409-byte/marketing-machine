Dialogue: 0,0:00:00.04,0:00:00.46,Cap,,0,0,0,,Sabe aquela
Dialogue: 0,0:00:00.46,0:00:01.14,Cap,,0,0,0,,sensação nos
Dialogue: 0,0:00:01.14,0:00:01.92,Cap,,0,0,0,,primeiros quinze,
Dialogue: 0,0:00:01.92,0:00:02.38,Cap,,0,0,0,,vinte minutos
Dialogue: 0,0:00:02.38,0:00:02.72,Cap,,0,0,0,,de prova
Dialogue: 0,0:00:02.72,0:00:02.94,Cap,,0,0,0,,que seu
Dialogue: 0,0:00:02.94,0:00:03.42,Cap,,0,0,0,,cérebro ainda
Dialogue: 0,0:00:03.42,0:00:03.72,Cap,,0,0,0,,nem tá
Dialogue: 0,0:00:03.72,0:00:04.22,Cap,,0,0,0,,ligado?
Dialogue: 0,0:00:04.22,0:00:04.56,Cap,,0,0,0,,Você lê
Dialogue: 0,0:00:04.56,0:00:05.34,Cap,,0,0,0,,as questões
Dialogue: 0,0:00:05.34,0:00:05.62,Cap,,0,0,0,,duas,
Dialogue: 0,0:00:05.62,0:00:06.24,Cap,,0,0,0,,três vezes
Dialogue: 0,0:00:06.24,0:00:06.44,Cap,,0,0,0,,e não
Dialogue: 0,0:00:06.44,0:00:07.23,Cap,,0,0,0,,entende direito,
Dialogue: 0,0:00:07.23,0:00:07.51,Cap,,0,0,0,,como se
Dialogue: 0,0:00:07.51,0:00:07.85,Cap,,0,0,0,,seu cérebro
Dialogue: 0,0:00:07.85,0:00:08.33,Cap,,0,0,0,,ainda tivesse
Dialogue: 0,0:00:08.33,0:00:08.98,Cap,,0,0,0,,aquecendo?
Dialogue: 0,0:00:08.98,0:00:09.46,Cap,,0,0,0,,Eu sentia
Dialogue: 0,0:00:09.46,0:00:10.16,Cap,,0,0,0,,muito isso.
Dialogue: 0,0:00:10.16,0:00:10.66,Cap,,0,0,0,,Então,
Dialogue: 0,0:00:10.66,0:00:10.92,Cap,,0,0,0,,no dia
Dialogue: 0,0:00:10.92,0:00:11.54,Cap,,0,0,0,,da prova,
Dialogue: 0,0:00:11.54,0:00:12.52,Cap,,0,0,0,,aproximadamente umas
Dialogue: 0,0:00:12.52,0:00:12.84,Cap,,0,0,0,,onze da
Dialogue: 0,0:00:12.84,0:00:13.12,Cap,,0,0,0,,manhã,
Dialogue: 0,0:00:13.12,0:00:13.80,Cap,,0,0,0,,antes sequer
Dialogue: 0,0:00:13.80,0:00:13.94,Cap,,0,0,0,,de eu
Dialogue: 0,0:00:13.94,0:00:14.26,Cap,,0,0,0,,sair de
Dialogue: 0,0:00:14.26,0:00:14.74,Cap,,0,0,0,,casa,
Dialogue: 0,0:00:14.74,0:00:15.14,Cap,,0,0,0,,eu fazia
Dialogue: 0,0:00:15.14,0:00:15.90,Cap,,0,0,0,,sempre cinco
Dialogue: 0,0:00:15.90,0:00:16.30,Cap,,0,0,0,,questões de
Dialogue: 0,0:00:16.30,0:00:16.97,Cap,,0,0,0,,Matemática.
Dialogue: 0,0:00:16.97,0:00:17.63,Cap,,0,0,0,,Só questões
Dialogue: 0,0:00:17.63,0:00:18.19,Cap,,0,0,0,,fáceis.
Dialogue: 0,0:00:18.19,0:00:18.71,Cap,,0,0,0,,Isso servia
Dialogue: 0,0:00:18.71,0:00:19.29,Cap,,0,0,0,,pra duas
Dialogue: 0,0:00:19.29,0:00:19.69,Cap,,0,0,0,,coisas:
Dialogue: 0,0:00:19.69,0:00:20.07,Cap,,0,0,0,,aquecer o
Dialogue: 0,0:00:20.07,0:00:20.85,Cap,,0,0,0,,meu cérebro
Dialogue: 0,0:00:20.85,0:00:21.07,Cap,,0,0,0,,e eu
Dialogue: 0,0:00:21.07,0:00:22.25,Cap,,0,0,0,,ganhar confiança.
Dialogue: 0,0:00:22.25,0:00:22.57,Cap,,0,0,0,,Eu sempre
Dialogue: 0,0:00:22.57,0:00:23.25,Cap,,0,0,0,,acertava aquelas
Dialogue: 0,0:00:23.25,0:00:24.13,Cap,,0,0,0,,cinco questões,
Dialogue: 0,0:00:24.13,0:00:24.59,Cap,,0,0,0,,me sentia
Dialogue: 0,0:00:24.59,0:00:24.89,Cap,,0,0,0,,bem por
Dialogue: 0,0:00:24.89,0:00:25.69,Cap,,0,0,0,,conta disso
Dialogue: 0,0:00:25.69,0:00:26.03,Cap,,0,0,0,,e também
Dialogue: 0,0:00:26.03,0:00:26.55,Cap,,0,0,0,,chegava na
Dialogue: 0,0:00:26.55,0:00:26.99,Cap,,0,0,0,,prova mais
Dialogue: 0,0:00:26.99,0:00:27.65,Cap,,0,0,0,,ligado,
Dialogue: 0,0:00:27.65,0:00:27.99,Cap,,0,0,0,,sem tá
Dialogue: 0,0:00:27.99,0:00:28.73,Cap,,0,0,0,,disperso.
Dialogue: 0,0:00:28.73,0:00:29.19,Cap,,0,0,0,,E
