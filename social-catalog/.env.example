# Copie para social-catalog/.env e preencha. Serve pra VER (fetch_ig.py) e POSTAR (post_ig.py).
# Token de longa duração do Instagram (conta profissional). Dura ~60 dias.
# Escopos: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement, business_management
IG_ACCESS_TOKEN=
# Opcional: se já souber o ID da conta IG. Vazio = o script descobre pela Página.
IG_USER_ID=
# Opcional: token da Página do FB. Vazio = o script deriva do IG_ACCESS_TOKEN.
IG_PAGE_TOKEN=
# Opcional: versão da Graph API (padrão v21.0).
IG_API_VERSION=
